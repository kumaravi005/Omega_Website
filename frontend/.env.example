# Copy this file to `.env` in this folder for local development.
# Never commit the real .env file — see the root .gitignore.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Base URL of the admission-enquiry backend (see ../backend). Point this at
# the deployed API's real URL in production.
VITE_API_URL=http://localhost:4000
